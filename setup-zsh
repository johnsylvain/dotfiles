#!/bin/bash

set -e

if [ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
  echo "oh-my-zsh not found at $HOME/.oh-my-zsh/oh-my-zsh.sh; ensuring a clean install..."

  if [ -d "$HOME/.oh-my-zsh" ]; then
    backup_dir="$HOME/.oh-my-zsh.bak.$(date +%Y%m%d%H%M%S)"
    echo "Backing up existing $HOME/.oh-my-zsh to $backup_dir"
    mv "$HOME/.oh-my-zsh" "$backup_dir"
  fi

  # Some shells export $ZSH; the installer refuses to proceed if it points at an existing dir.
  env -u ZSH sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "oh-my-zsh already present: $HOME/.oh-my-zsh/oh-my-zsh.sh"
fi

mkdir -p "$HOME/.oh-my-zsh/themes" "$HOME/.oh-my-zsh/custom/plugins"

source './setup-helpers'

ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
ZSH_SYNTAX_HIGHLIGHTING_DIR="$ZSH_CUSTOM_DIR/plugins/zsh-syntax-highlighting"
if [ ! -d "$ZSH_SYNTAX_HIGHLIGHTING_DIR" ]; then
  echo "Cloning zsh-syntax-highlighting into $ZSH_SYNTAX_HIGHLIGHTING_DIR..."
  git clone https://github.com/zsh-users/zsh-syntax-highlighting.git "$ZSH_SYNTAX_HIGHLIGHTING_DIR"
else
  echo "zsh-syntax-highlighting already present: $ZSH_SYNTAX_HIGHLIGHTING_DIR"
fi

install_dotfile "oh-my-zsh/themes/john.zsh-theme"
install_dotfile "zshrc"
install_dotfile "zsh_functions"
install_dotfile "zsh_aliases"
