#!/bin/sh

if test ! $(which brew); then
  /usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
fi

# brew update
# brew upgrade --all

brew install tmux
brew install jq
brew install yarn
brew install tailscale

# Install casks
brew install --appdir="/Applications" visual-studio-code --cask
brew install --appdir="/Applications" brave-browser --cask
brew install --appdir="/Applications" slack --cask
brew install --appdir="/Applications" obs --cask
brew install --appdir="/Applications" iterm2 --cask
brew install --appdir="/Applications" nordvpn --cask
brew install --appdir="/Applications" plexamp --cask
brew install --appdir="/Applications" cursor --cask
brew install --appdir="/Applications" codex --cask

brew cleanup
